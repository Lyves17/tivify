# ===========================================
# TIVIFY - Environment Variables
# ===========================================
# Copy this file as .env and adjust all values for your deployment
# SECURITY: Change all default credentials before deploying to production

# --- General ---
# Base URL for API and streaming (used by frontend and Android app)
BASE_URL=http://localhost

# --- PostgreSQL ---
# SECURITY: Change these credentials in production!
# Default values are only acceptable for local development
DB_USER=tivify
DB_PASSWORD=changeme
DB_NAME=tivify
DB_HOST=postgres
DB_PORT=5432
# DB_SSLMODE options:
#   disable - No SSL (local development only)
#   require - SSL required (production)
#   verify-ca - SSL with CA verification
#   verify-full - SSL with full hostname verification
# SECURITY: Use 'require' or 'verify-full' in production
DB_SSLMODE=disable

# --- Redis ---
# SECURITY: Change password in production
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# --- Backend ---
# APP_ENV controls behavior and logging
APP_ENV=development
APP_PORT=8080
# SECURITY: Generate strong JWT_SECRET in production (min 32 chars)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h
MEDIA_PATH=/media
FFMPEG_PATH=/usr/bin/ffmpeg

# --- Frontend ---
# URLs used by Next.js frontend for API calls
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_STREAM_URL=http://localhost

# --- Admin Account (created on first startup) ---
# SECURITY: Change default admin credentials on first login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@tivify.local

# --- Tailscale (Remote access over encrypted network) ---
# SECURITY: Use ephemeral keys - they auto-expire in 1 day
# Generate at: https://login.tailscale.com/admin/settings/keys
# Do NOT commit persistent auth keys to version control
TS_AUTHKEY=tskey-auth-xxxxx
TS_HOSTNAME=tivify
# TS_SERVE_MODE options:
#   https - Use Tailscale's automatic HTTPS certificates
#   proxy - HTTP only (suitable for internal tailnet access)
TS_SERVE_MODE=https

# --- Library Scanner (External media library) ---
# Path to folder/drive containing movies and TV series
LIBRARY_PATH=/mnt/usb
# Get TMDB_API_KEY at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Docker Runtime Configuration ---
# Container resource limits (memory in MB)
# These should match deploy.resources.limits in docker-compose.yml
POSTGRES_MEMORY_LIMIT=1024
REDIS_MEMORY_LIMIT=256
BACKEND_MEMORY_LIMIT=512
FRONTEND_MEMORY_LIMIT=256
MEDIA_SERVER_MEMORY_LIMIT=256
NGINX_MEMORY_LIMIT=256

# --- Backup Configuration ---
# Backup schedule (cron format: minute hour day month day-of-week)
BACKUP_SCHEDULE=0 2 * * *
# Retention period in days
BACKUP_RETENTION_DAYS=30
# Notification email for backup failures (optional)
BACKUP_NOTIFICATION_EMAIL=admin@tivify.local

# --- Network Configuration ---
# Enable Tailscale remote access
ENABLE_TAILSCALE=true
# Port mapping mode for development (use docker-compose.dev.yml for exposed ports)
EXPOSE_BACKEND_PORT=false
EXPOSE_FRONTEND_PORT=false

# --- Security Configuration ---
# SECURITY: Change these in production!
# Password minimum length requirement
PASSWORD_MIN_LENGTH=8
# Token expiration times
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
# Session timeout
SESSION_TIMEOUT=30m

# --- API Configuration ---
# Rate limiting parameters
API_RATE_LIMIT_REQUESTS=30
API_RATE_LIMIT_WINDOW=60
# Auth endpoint rate limiting
AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW=60

# --- Streaming Configuration ---
# Live stream timeout in seconds (default: 86400 = 24 hours)
LIVE_STREAM_TIMEOUT=86400
# HLS segment duration
HLS_SEGMENT_DURATION=10
# HLS playlist size
HLS_PLAYLIST_SIZE=5

# --- FFMPEG Configuration ---
# FFmpeg encoding presets: ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow
FFMPEG_PRESET=faster
# Audio bitrate for transcoding (e.g., 128k, 192k, 256k)
FFMPEG_AUDIO_BITRATE=192k
# Enable hardware acceleration (nvidia, intel, none)
FFMPEG_HWACCEL=none

# --- APK Distribution ---
# Android app version (should match VERSION file)
APK_VERSION=1.0.0
# Enable APK download endpoint
ENABLE_APK_DOWNLOAD=true

# --- Database Configuration ---
# Connection pool size for backend
DB_POOL_SIZE=20
DB_POOL_TIMEOUT=5000
# Backup verification (validate backup integrity)
DB_BACKUP_VERIFY=true

# --- Logging Configuration ---
# Log level: debug, info, warn, error
LOG_LEVEL=info
# Enable structured JSON logging
LOG_FORMAT=json
# Syslog server for centralized logging (optional)
SYSLOG_SERVER=
SYSLOG_PORT=514
